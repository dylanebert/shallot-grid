{
    "name": "@dylanebert/shallot-grid",
    "version": "0.2.0-next.2",
    "description": "Infinite world grid with axis lines for Shallot: a fullscreen ray-plane pass that blends decade levels so it reads at any zoom.",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "Dylan Ebert <dylan.ebert@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/dylanebert/shallot-grid.git"
    },
    "homepage": "https://github.com/dylanebert/shallot-grid",
    "bugs": "https://github.com/dylanebert/shallot-grid/issues",
    "keywords": [
        "webgpu",
        "grid",
        "shallot"
    ],
    "type": "module",
    "sideEffects": false,
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.2"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.gpu.ts"
    ],
    "scripts": {
        "dev": "vite examples/world-grid --host 127.0.0.1",
        "build": "vite build examples/world-grid",
        "preview": "vite preview examples/world-grid",
        "check": "tsc --noEmit && biome check",
        "test": "bun test --timeout=250",
        "test:gpu": "bun test ./src/grid.gpu.ts",
        "test:browser": "playwright test -c examples/world-grid"
    },
    "peerDependencies": {
        "@dylanebert/shallot": "^0.10.0-next.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "@dylanebert/shallot": "^0.10.0-next.1",
        "@types/bun": "latest",
        "@webgpu/types": "^0.1.72",
        "bun-webgpu": "github:dylanebert/bun-webgpu#7b75d0440d2f22e2c9a1cb383d15529652c53d98",
        "playwright": "^1.63.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.0"
    }
}
