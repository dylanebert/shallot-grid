{
    "name": "@dylanebert/shallot-grid",
    "version": "0.1.3",
    "description": "Infinite world grid with axis lines for Shallot: a fullscreen ray-plane pass that blends decade levels so it reads at any zoom.",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "Dylan Ebert <dylan.ebert@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/dylanebert/shallot-grid.git"
    },
    "homepage": "https://github.com/dylanebert/shallot-grid",
    "bugs": "https://github.com/dylanebert/shallot-grid/issues",
    "keywords": [
        "webgpu",
        "grid",
        "shallot"
    ],
    "type": "module",
    "sideEffects": false,
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.2"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.gpu.ts"
    ],
    "scripts": {
        "check": "tsc --noEmit && tsc --noEmit -p examples/world-grid/tsconfig.json && biome check",
        "test": "bun test --timeout=250",
        "test:gpu": "bun test ./src/grid.gpu.ts",
        "test:browser": "bun run --cwd examples/world-grid test:browser"
    },
    "peerDependencies": {
        "@dylanebert/shallot": "^0.10.0",
        "typegpu": "~0.12.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "@dylanebert/shallot": "github:dylanebert/shallot#e5870e50b276777046224ffc513cc229c3610ea8",
        "@dylanebert/shallot-grid": "link:.",
        "@types/bun": "latest",
        "@webgpu/types": "^0.1.72",
        "bun-webgpu": "github:dylanebert/bun-webgpu#7b75d0440d2f22e2c9a1cb383d15529652c53d98",
        "typegpu": "~0.12.5",
        "typescript": "^7.0.2"
    },
    "workspaces": [
        "examples/*"
    ]
}
